# Exemplo de Configuração de Ambiente para os Scripts
# Copie este arquivo para .env ou .env.local e configure os valores da sua rede

FIRESTICK_USER="termux_user"
FIRESTICK_HOST="192.168.0.100"
FIRESTICK_PORT="8022"
FIRESTICK_DIR="/data/data/com.termux/files/home/hub-storage-server"
FIRESTICK_STORAGE_DIR="/storage/XXXX-XXXX/Android/data/com.termux/files/hub_data"
REMOTE_ORIGIN="https://storage.example.com"

